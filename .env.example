# Application
APP_NAME=ScreenPilot
APP_ENV=development
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://screenpilot:screenpilot@localhost:5432/screenpilot
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEPENDENCY_CHECK_TIMEOUT_SECONDS=2

# Agent / LLM (Phase 3: mock provider only — not a real model API)
LLM_PROVIDER=mock
LLM_MODEL=mock-planner-v1
LLM_API_KEY=
AGENT_MAX_PLAN_STEPS=20
TOOL_DEFAULT_TIMEOUT_SECONDS=5

# Safety / approvals (Phase 9)
APPROVAL_EXPIRE_HOURS=24
SAFETY_REQUIRE_APPROVAL_FOR_MODERATE=true

# Workflow engine (Phase 10)
WORKFLOW_MAX_EXECUTIONS_PER_RUN=100
WORKFLOW_MAX_RETRIES_PER_STEP=3
WORKFLOW_MAX_REVISION_LOOPS=2

# Browser automation (Phase 5 — Chromium via Playwright)
BROWSER_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_ALLOW_LOCALHOST=false
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=10000

# Desktop automation (Phase 6 — mock adapter by default)
DESKTOP_ENABLED=false
DESKTOP_ADAPTER=mock
DESKTOP_ACTION_TIMEOUT_SECONDS=10

# Vision / OCR (Phase 7)
VISION_ENABLED=false
VISION_OCR_PROVIDER=mock
VISION_MODEL_PROVIDER=mock
VISION_MAX_IMAGE_BYTES=4000000
VISION_MAX_WIDTH=1920
VISION_MAX_HEIGHT=1080

# Agent memory (Phase 8)
MEMORY_MAX_ENTRIES_PER_TASK=200
MEMORY_CONTEXT_WINDOW_CHARS=12000
MEMORY_SHORT_TERM_TTL_HOURS=24
MEMORY_CONVERSATION_TTL_DAYS=30

# Auth (use a long random value in every non-test environment)
JWT_SECRET=change-me-use-at-least-32-random-characters
JWT_ISSUER=screenpilot
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL (docker-compose)
POSTGRES_DB=screenpilot
POSTGRES_USER=screenpilot
POSTGRES_PASSWORD=change-me-screenpilot-db-password

# Frontend (Vite dev server and container build)
VITE_API_BASE_URL=http://localhost:8000